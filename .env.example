# Management project. On hosting set these as environment variables.
NEXT_PUBLIC_SUPABASE_URL=https://your-management-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
# Legacy ODIVON_MANAGEMENT_URL / ODIVON_MANAGEMENT_PUBLIC_KEY override the above when defined.
# Local clinic override is optional; production resolves clinics from the management directory.
# ODIVON_CLINIC_CODE=local-clinic
# ODIVON_CLINIC_URL=http://127.0.0.1:55321
# ODIVON_CLINIC_PUBLIC_KEY=replace-with-local-anon-key
ODIVON_TURNSTILE_SITE_KEY=
# Local owner seed only; never placed in browser config.
ODIVON_CLINIC_SERVICE_KEY=
ODIVON_LOCAL_OWNER_PASSWORD=
